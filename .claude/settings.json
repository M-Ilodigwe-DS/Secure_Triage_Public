{
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(ruff check *)",
      "Bash(pip install -e *)",
      "Bash(python scripts/generate_data.py --check)",
      "Bash(python -m securetriage check-data)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git switch *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/secrets/**)",
      "Read(~/.aws/**)",
      "Read(./answer_key/**)",
      "Edit(./tests/**)",
      "Edit(./tests_live/**)",
      "Edit(./data/**)",
      "Edit(./evals/**)",
      "Edit(./answer_key/**)",
      "Edit(./docs/SPEC.md)",
      "Edit(./PHASE)",
      "Edit(./.github/**)",
      "Edit(./.claude/**)",
      "Bash(git push *)",
      "Bash(aws *)",
      "Bash(sam *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh" }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh" }]
      }
    ]
  }
}
