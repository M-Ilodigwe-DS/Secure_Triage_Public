# Copy to .env and fill in. .env is in .gitignore. Load it with:  set -a; source .env; set +a
LLM_BACKEND=bedrock                # or: anthropic (then also set ANTHROPIC_API_KEY)
AWS_REGION=us-east-1
TRIAGE_MODEL=anthropic.claude-haiku-5-5
TOOL_CHOICE=any                    # set to auto if the smoke test shows your model rejects "any"
EMBED_DIMS=1024
TOP_K=5
# from the Aura credentials file you downloaded:
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=paste-here-locally-only
NEO4J_DATABASE=neo4j
# connection tuning (defaults suit Aura Free; the names are the neo4j driver's own options, in seconds)
# NEO4J_MAX_LIFETIME_S=300  NEO4J_LIVENESS_S=30  NEO4J_CONNECT_TIMEOUT_S=10  NEO4J_ACQUIRE_TIMEOUT_S=20  NEO4J_RETRY_S=15
# cost controls: CHECK your provider's price page; these are per million tokens
PRICE_IN_PER_M=0.10
PRICE_OUT_PER_M=0.50
RUN_MAX_USD=0.05
SPEND_CAP_USD=5.00
# Claude Agent SDK pathway; the SDK does not read this file, export these in the shell
# AGENT_SDK_MODEL=paste-the-exact-model-or-inference-profile-id-from-the-Bedrock-console
# CLAUDE_CODE_USE_BEDROCK=1          # the code sets this for the child process when LLM_BACKEND=bedrock
# ANTHROPIC_API_KEY=                 # only if LLM_BACKEND=anthropic; type it with read -s, never commit it
# findings database: sqlite (a local file, default) or dynamodb (the deployed table). Never Neo4j.
# FINDINGS_BACKEND=sqlite                   # or dynamodb
# FINDINGS_DB=.data/findings.db
# FINDINGS_TABLE=securetriage-findings       # only with FINDINGS_BACKEND=dynamodb
# Streamlit dashboard: set these in dashboard_app/.streamlit/secrets.toml, or here to run locally
# DATA_URL=https://<id>.lambda-url.<region>.on.aws/    # the DatapointsUrl stack output
# DATA_TOKEN=                                          # the dashboard token; type it with read -s, never commit it
